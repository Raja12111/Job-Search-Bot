# Required for the daily Vercel cron. Generate a long random string.
CRON_SECRET=

# Default search used by /api/cron (the UI can override these live)
JOB_QUERY=SEO
JOB_LOCATION=remote
JOB_REMOTE_ONLY=true

# Cron only notifies jobs newer than this many hours
CRON_FRESH_HOURS=36

# Optional — Adzuna country listings (https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Optional — Indeed, Glassdoor, ZipRecruiter, LinkedIn, Monster
# Get a RapidAPI key and subscribe to JSearch: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# Optional — Reed UK jobs (https://www.reed.co.uk/developers)
REED_API_KEY=

# Optional — Jooble aggregator (https://jooble.org/api/about)
JOOBLE_API_KEY=

# Optional but recommended for City firm scan (https://serper.dev)
# Free starter credits. Makes city → SEO firm discovery much stronger.
SERPER_API_KEY=

# Optional notifications
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=Job Search Bot <beth.t@example.com>
